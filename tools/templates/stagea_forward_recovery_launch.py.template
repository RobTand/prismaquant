"""${LABEL} ${campaign_name}: verify an immutable native recovery row and saved IDs."""
import argparse
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent
PANEL = Path(${panel})
RUN = PANEL / ${run}
HEAD = ${source_head}
MANIFEST = ROOT / ${manifest_name}
MANIFEST_SHA = ${manifest_sha256}
CAPSULE = {'path': ${capsule_path}, 'sha256': ${capsule_sha256}}


def bound_document(filename, expected=None):
    from prismaquant.staged_manifest import read_document
    from prismaquant.schemas import strict_json_loads
    raw, _ = read_document(str(filename), 16 << 20)
    if expected is not None and hashlib.sha256(raw).hexdigest() != expected:
        raise RuntimeError('immutable launcher input changed')
    def invalid(value):
        return ValueError('invalid launcher JSON: ' + value)
    return strict_json_loads(raw, duplicate=invalid, constant=invalid)


def require_argument(argv, flag, expected):
    positions = [i for i, value in enumerate(argv) if value == flag]
    if len(positions) != 1 or argv[positions[0] + 1:positions[0] + 2] != [str(expected)]:
        raise RuntimeError('reviewed native argv differs at ' + flag)


def plan(checkout, row_path, row_sha256):
    from prismaquant.staged_manifest import read_document
    from prismaquant.stage_a_produced_output import declaration_launch_arguments
    from prismaquant.joint_forward_resume import _read, chain_records
    pins = bound_document(ROOT / 'package-pins.json')
    if not isinstance(pins, dict) or len(pins) > 64:
        raise ValueError('finite package pin roster required')
    for name, expected in pins.items():
        if Path(name).name != name or name in ('.', '..'):
            raise ValueError('package member escapes root')
        raw, _ = read_document(str(ROOT / name), 64 << 20)
        if hashlib.sha256(raw).hexdigest() != expected:
            raise RuntimeError('package input changed: ' + name)
    wire, _ = read_document(str(MANIFEST), 64 << 20)
    if hashlib.sha256(wire).hexdigest() != MANIFEST_SHA:
        raise RuntimeError('scientific read manifest changed')
    campaign = bound_document(PANEL / ${first_record})['campaign']
    for name, expected in ${campaign_scope}.items():
        if campaign['campaign_scope'].get(name) != expected:
            raise RuntimeError(${scope_refusal} + name)
    for name, expected in ${campaign_bindings}.items():
        if campaign.get(name) != expected:
            raise RuntimeError('scientific campaign binding changed: ' + name)
    capsule, _ = _read(CAPSULE['path'], CAPSULE['sha256'])
    chain_records(capsule)
    row = bound_document(row_path, row_sha256)
    if row.get('cwd') != str(checkout) or row.get('data_manifest') != str(MANIFEST):
        raise RuntimeError('native row source/read manifest differs')
    argv = row['argv']
    for flag, value in (('--forward-recovery', CAPSULE['path']),
                        ('--forward-recovery-sha256', CAPSULE['sha256']),
                        ('--artifact-budget-bytes', ${artifact_budget_bytes}),
                        ('--prefetch-override', ROOT / 'prefetch-override-r7.json')):
        require_argument(argv, flag, value)
    declaration = declaration_launch_arguments(ROOT / 'stagea-512-template-r7.json')
    for flag, value in zip(declaration[::2], declaration[1::2]):
        require_argument(argv, flag, value)
    return {'schema': 'prismaquant.stagea.${label}.native_forward_recovery.v2',
            'source_head': HEAD, 'row': row, 'capsule': CAPSULE, 'output_root': str(RUN)}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('checkout', type=Path)
    parser.add_argument('--row', type=Path, required=True)
    parser.add_argument('--row-sha256', required=True)
    parser.add_argument('--state-dir', type=Path, required=True)
    parser.add_argument('--afterok', type=Path, action='append', default=[])
    parser.add_argument('--launch', action='store_true')
    args = parser.parse_args()
    document = plan(args.checkout, args.row, args.row_sha256)
    if not args.launch:
        print(json.dumps(document, sort_keys=True, indent=2))
        return
    from prismaquant.flux_jobs import load_submission
    from prismaquant.tessera_campaign_rows import submit_rows
    import subprocess
    head = subprocess.check_output(['git', '-C', str(args.checkout), 'rev-parse', 'HEAD'], text=True).strip()
    if head != HEAD:
        raise RuntimeError('launcher requires the reviewed source commit')
    submissions = submit_rows([document['row']], args.state_dir,
        afterok=[load_submission(path) for path in args.afterok])
    print(json.dumps({'job_ids': [submission.job_id for submission in submissions]}, sort_keys=True))


if __name__ == '__main__':
    main()
