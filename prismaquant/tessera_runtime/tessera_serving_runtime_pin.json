{
  "schema": "prismaquant.tessera_serving_runtime_pin.v2",
  "repository": "https://github.com/RobTand/tessera.git",
  "commit": "fca4c6ce0e16c41d94a1a3c4cfc21c4548dec6bb",
  "version": "0.1.0",
  "version_is_release": false,
  "contract_sha256": "ee065629b081d913a0351e43160c5c6e1bd38fa628cafd51e756e9caf3bb334e",
  "runtime_contract_schema": "tessera.runtime-contract.v1",
  "plugin_entry_point": "tessera = tessera.serving:register",
  "serving_residency_env": "TESSERA_SERVE_MODE",
  "serving_native_extensions": [
    {
      "module_name_prefix": "tessera_window_gemv",
      "filename_glob": "tessera_window_gemv*.so",
      "match": "basename_fnmatch",
      "when_unavailable": {
        "resident": {
          "status": "substituted",
          "decoder": "torch_window"
        },
        "streamed": {
          "status": "substituted",
          "decoder": "torch_window"
        }
      }
    },
    {
      "module_name_prefix": "tessera_routed_fused_e4m3",
      "filename_glob": "tessera_routed_fused_e4m3*.so",
      "match": "basename_fnmatch",
      "when_unavailable": {
        "resident": {
          "status": "substituted",
          "decoder": "native_window_moe_compact"
        },
        "streamed": {
          "status": "substituted",
          "decoder": "native_window_moe_compact"
        }
      }
    },
    {
      "module_name_prefix": "tessera_routed_fused_mma_e4m3",
      "filename_glob": "tessera_routed_fused_mma_e4m3*.so",
      "match": "basename_fnmatch",
      "when_unavailable": {
        "resident": {
          "status": "substituted",
          "decoder": "native_window_moe_compact"
        },
        "streamed": {
          "status": "substituted",
          "decoder": "native_window_moe_compact"
        }
      }
    },
    {
      "module_name_prefix": "tessera_routed_fused_value",
      "filename_glob": "tessera_routed_fused_value*.so",
      "match": "basename_fnmatch",
      "when_unavailable": {
        "resident": {
          "status": "substituted",
          "decoder": "native_window_moe_compact_folded"
        },
        "streamed": {
          "status": "substituted",
          "decoder": "native_window_moe_compact_folded"
        }
      }
    }
  ]
}
